#!/usr/bin/env bash
# Install the notclaude-coinflip launcher into a bin directory available to the shell.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
BIN_DIR=""
for candidate in /usr/local/bin /opt/homebrew/bin "$HOME/.local/bin"; do
  case ":$PATH:" in
    *":$candidate:"*)
      if [ -d "$candidate" ] && [ -w "$candidate" ]; then
        BIN_DIR="$candidate"
        break
      fi
      ;;
  esac
done

if [ -z "$BIN_DIR" ]; then
  BIN_DIR="$HOME/.local/bin"
fi

COINFLIP_TARGET="$BIN_DIR/notclaude-coinflip"

mkdir -p "$BIN_DIR"
ln -sf "$REPO_ROOT/scripts/notclaude" "$COINFLIP_TARGET"

case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *)
    SHELL_RC="$HOME/.zshrc"
    if [ -n "${SHELL:-}" ] && [ "$(basename "$SHELL")" = "bash" ]; then
      SHELL_RC="$HOME/.bashrc"
    fi
    if [ ! -f "$SHELL_RC" ] || ! grep -q 'HOME/.local/bin' "$SHELL_RC"; then
      printf '\nexport PATH="$HOME/.local/bin:$PATH"\n' >>"$SHELL_RC"
    fi
    export PATH="$BIN_DIR:$PATH"
    ;;
esac

echo "notclaude-coinflip installed at $COINFLIP_TARGET"
if command -v notclaude-coinflip >/dev/null 2>&1; then
  echo "Coinflip: notclaude-coinflip"
else
  echo "Current shell cannot see $BIN_DIR yet."
  echo "Run now: export PATH=\"$BIN_DIR:\$PATH\""
  echo "Then: notclaude-coinflip"
fi
